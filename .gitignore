# Dependencies
node_modules/

# Environment variables (never commit real secrets)
.env
.env.local

# Locally generated TLS certificate/key (regenerate per machine)
certs/

# Runtime data (Part 1 file store - superseded by MongoDB in Part 2)
api/src/data/users.json

# Logs
api/src/logs/*.log
!api/src/logs/.gitkeep
*.log

# Test / build output
coverage/
client/dist/
api/postman/reports/*
!api/postman/reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local AI assistant tooling config (machine-specific, not part of the submission)
.claude/

# CI test reports
test-results/
eslint-report.json
semgrep.sarif
gitleaks-report.json
