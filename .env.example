# Settings for `docker compose` (copy to .env - it is git-ignored).
# The API's own settings for running WITHOUT Docker live in api/.env.example.

# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin account created by: docker compose exec api node scripts/seedAdmin.js
# Must meet the password policy (8+ chars, upper, lower, number, symbol). Avoid "#".
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=

# Optional: ship logs to Better Stack (https://telemetry.betterstack.com -> Sources -> HTTP)
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=in.logs.betterstack.com

# Optional: host ports for the website (https://localhost:8443)
HTTPS_PORT=8443
HTTP_PORT=8080
PUBLIC_ORIGIN=https://localhost:8443

# Image names used by `docker compose build/push` and the CD pipeline
DOCKERHUB_NAMESPACE=evanildo1997
IMAGE_TAG=local
