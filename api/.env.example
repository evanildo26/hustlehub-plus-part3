# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Port the HTTPS server listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (local MongoDB Community Server by default)
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub

# Secret used to sign JSON Web Tokens - REQUIRED, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_before_running

# How long an issued JWT stays valid
JWT_EXPIRES_IN=1h

# Comma-separated list of origins allowed to call this API (frontend URL(s))
CORS_ORIGIN=https://localhost:5173

# Rate limits (all optional - these are the defaults)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_API_MAX=300

# Reverse proxies in front of the API. 0 when the API is reached directly;
# 1 behind the Docker nginx container (docker-compose sets this for you).
TRUST_PROXY=0

# Account lockout: failed logins for one email before it is locked, and for how long
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Security monitor: suspicious events from one IP within the window that raise a SECURITY_ALERT
SECURITY_ALERT_THRESHOLD=10
SECURITY_ALERT_WINDOW_MINUTES=5

# Cloud logging (Better Stack). Leave the token empty to log to the console and file only.
# Create a "HTTP" source at https://telemetry.betterstack.com and copy its source token and ingesting host.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=in.logs.betterstack.com

# Admin account created by `npm run seed:admin` (admins cannot self-register).
# Password must meet the same policy as user passwords. Avoid "#" (dotenv treats it as a comment) or wrap the value in quotes.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=replace_with_a_strong_password_1A!
